NODE_ENV=production
PORT=3000
BASEURL=https://your-domain.example.com

# Storage
STORAGE_ROOT=uploads
UPLOAD_MAX_BYTES=5242880
NEXT_PUBLIC_UPLOAD_MAX_BYTES=5242880

# Registration policy:
# true: allow register only when no user exists (self-use mode)
# false: allow public register
SELF_USE_MODE=true

# Database (SQLite example)
DATABASE_URL="file:./database.sqlite"

# Auth (⚠️ 生产环境必须修改！)
# 请使用强随机密钥，至少 32 个字符
# 生成命令: openssl rand -base64 32
JWT_SECRET="replace_with_a_random_32+_chars_secret"

# Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key
TURNSTILE_SECRET_KEY=your_turnstile_secret_key

# Optional
AUTH_COOKIE_NAME=pichome_token
